# 이 파일을 복사해 .env 로 저장한 뒤 값을 수정하세요. (.env 는 Git에 올리지 않습니다)

# 서버 포트 (로컬 8000 / Hugging Face Spaces 7860)
PORT=8000

# true: AI 파이프라인 없이 표준 JSON 계약 + 플레이스홀더 이미지 반환 (프론트엔드 개발용)
# false: app/pipeline/stage1~5 실제 구현 + models/ 가중치 사용
USE_MOCK_PIPELINE=true

# Mock 점수 방식: fixed = 명세 예시값(38점) 고정 / hash = 이미지 pHash 기반으로 0~100점 분산 (4등급 UI 테스트용)
MOCK_SCORE_MODE=fixed

# 기본값은 backend/app.db (SQLite). PostgreSQL 예시:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# CORS 허용 Origin. 개발 중엔 *, 운영에선 쉼표로 구분해 Vercel 도메인만 허용
# ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOW_ORIGINS=*

# ── 보안 ──
# 접근 키: 외부 공개(Tailscale Funnel 등) 전에 반드시 설정. 팀원에게만 따로 알려주기
# 비어 있으면 키 검사를 하지 않음 (내 PC 에서만 쓸 때)
# 키 만들기: python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_KEY=

# 같은 IP 의 분석 요청 분당 최대 횟수 (0 = 제한 없음)
RATE_LIMIT_PER_MIN=20

# 캐시 매칭 기준: phash(명세 기본) / sha256(완전히 동일한 파일만 캐시) / off
CACHE_MATCH=phash

# 모델 가중치 파일명 (backend/models/ 기준)
ONNX_MODEL_FILE=detector.onnx
META_CLASSIFIER_FILE=meta_xgb.joblib
